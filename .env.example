# Copy to .env.local and fill in. Never commit real keys.

# Postgres connection string. Leave empty to use embedded PGlite in ./.data/pglite
DATABASE_URL=
SEED_ON_START=true

# NEAR (testnet)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_ESCROW_CONTRACT=escrow.homebound-hq.testnet
# Circle USDC on NEAR testnet (6 decimals)
NEAR_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
NEAR_AGENT_ACCOUNT=agent.homebound-hq.testnet
# Function-call key scoped strictly to submit_verdict, propose_release, and anchor_ledger
NEAR_AGENT_PRIVATE_KEY=
# Demo contractor NEAR account (payee written into the escrow contract)
NEAR_CONTRACTOR_ACCOUNT=chidi.homebound-hq.testnet
# Testnet demo scale: 1 USDC on chain stands for $1,000 of the real tranche
NEAR_DEMO_DIVISOR=1000

# NEAR AI Cloud (https://cloud.near.ai): TEE-signed photo verdicts
NEARAI_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.8-27B
